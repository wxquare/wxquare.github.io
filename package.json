{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "build:ai-book": "mdbook build books/ai-book",
    "build:system-design-book": "mdbook build books/system-design-architecture-book",
    "build:books": "npm run build:ai-book && npm run build:system-design-book",
    "stage:books": "node bin/stage-books.js",
    "clean": "hexo clean",
    "check:links": "node scripts/check-generated-links.js public",
    "deploy": "hexo deploy",
    "test": "node --test test/*.test.js",
    "server": "hexo server",
    "server:site": "npm run clean && npm run build && npm run build:books && npm run stage:books && hexo server -p 3000",
    "server:system-design-architecture-book": "npm run server:site"
  },
  "hexo": {
    "version": "7.2.0"
  },
  "dependencies": {
    "hexo": "^7.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-mathjax": "^0.9.1",
    "hexo-filter-mermaid-diagrams": "^1.0.5",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-pdf": "^1.1.1",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.0.0",
    "hexo-renderer-stylus": "^3.0.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-theme-next": "^8.20.0"
  }
}
