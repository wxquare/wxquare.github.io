// 系列专题样式
.site-series {
  margin-top: 30px;
  padding: 20px 15px;
  background: var(--content-bg-color);
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.site-series-title {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 15px;
  color: var(--text-color);
  padding-bottom: 10px;
  border-bottom: 2px solid var(--border-color);
  
  i {
    margin-right: 8px;
    color: var(--theme-color);
  }
}

.series-list {
  list-style: none !important;
  padding: 0 !important;
  margin: 0;
}

.series-item {
  margin-bottom: 10px;
  list-style: none !important;
  
  &::before {
    display: none !important;
  }
  
  a {
    display: flex;
    align-items: center;
    padding: 12px 10px;
    border-radius: 6px;
    text-decoration: none !important;
    border: 1px solid transparent !important;
    color: var(--text-color);
    transition: all 0.3s ease;
    
    &:hover {
      background: var(--hover-bg-color);
      border-color: var(--series-color) !important;
      transform: translateX(3px);
      
      .series-name {
        color: var(--series-color);
      }
      
      i {
        transform: scale(1.1);
      }
    }
  }
  
  i {
    font-size: 18px;
    width: 24px;
    margin-right: 10px;
    transition: transform 0.3s ease;
  }
  
  .series-name {
    flex: 1;
    font-weight: 500;
    font-size: 14px;
    transition: color 0.3s ease;
  }
  
  .series-count {
    font-size: 12px;
    color: var(--grey-5);
    background: var(--tag-bg-color);
    padding: 2px 8px;
    border-radius: 10px;
    font-weight: 500;
  }
}

// 每个系列的主题色
.series-item.ecommerce {
  --series-color: #ff6b6b;
  
  i {
    color: #ff6b6b;
  }
}

.series-item.system-design {
  --series-color: #4834d4;
  
  i {
    color: #4834d4;
  }
}

.series-item.fundamentals {
  --series-color: #26de81;
  
  i {
    color: #26de81;
  }
}

// 首页书籍卡片
.home-books {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin: 24px 0 42px;
}

.home-book-card {
  position: relative;
  display: flex;
  min-height: 280px;
  flex-direction: column;
  overflow: hidden;
  padding: 28px 26px 24px;
  border: 1px solid var(--border-color);
  border-radius: 14px;
  background: var(--content-bg-color);
  box-shadow: 0 8px 24px rgba(31, 35, 41, 0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease;

  &::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 4px;
    content: '';
    background: var(--book-accent);
  }

  &:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(31, 35, 41, 0.12);
  }

  h3 {
    margin: 10px 0 12px;
    font-size: 20px;
    line-height: 1.45;

    a {
      color: var(--text-color);
      text-decoration: none;
    }
  }

  p {
    margin: 0;
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.8;
  }
}

.home-book-card--system {
  --book-accent: #3b82f6;
  --book-tag-bg: rgba(59, 130, 246, 0.1);
}

.home-book-card--ai {
  --book-accent: #8b5cf6;
  --book-tag-bg: rgba(139, 92, 246, 0.1);
}

.home-book-card__eyebrow {
  color: var(--book-accent);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.home-book-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 20px;

  span {
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--book-tag-bg);
    color: var(--book-accent);
    font-size: 12px;
  }
}

.home-book-card__link {
  align-self: flex-start;
  margin-top: auto;
  padding-top: 22px;
  color: var(--book-accent);
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
}

.series-item.ai {
  --series-color: #fd79a8;
  
  i {
    color: #fd79a8;
  }
}

// 移动端适配
+mobile() {
  .home-books {
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 18px;
  }

  .home-book-card {
    min-height: 0;
    padding: 24px 20px 20px;

    h3 {
      font-size: 18px;
    }
  }

  .site-series {
    margin-top: 20px;
    padding: 15px 10px;
  }
  
  .series-item a {
    padding: 10px 8px;
  }
  
  .series-name {
    font-size: 13px !important;
  }
  
  .series-count {
    font-size: 11px !important;
  }
}
