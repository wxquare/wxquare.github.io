{
  "startOnLoad": false,
  "securityLevel": "strict",
  "theme": "base",
  "fontFamily": "\"PingFang SC\",\"Microsoft YaHei\",Arial,sans-serif",
  "themeCSS": ".edgeLabel text{fill:#20252a!important}.edgeLabel rect{fill:#fafcfc!important}",
  "themeVariables": {
    "primaryColor": "#eef5f5",
    "primaryTextColor": "#20252a",
    "primaryBorderColor": "#739699",
    "lineColor": "#51767c",
    "secondaryColor": "#fbf1e8",
    "tertiaryColor": "#f3f2fa",
    "fontSize": "18px"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "linear",
    "nodeSpacing": 35,
    "rankSpacing": 48
  },
  "sequence": {
    "useMaxWidth": true,
    "actorMargin": 35,
    "diagramMarginX": 16
  }
}
