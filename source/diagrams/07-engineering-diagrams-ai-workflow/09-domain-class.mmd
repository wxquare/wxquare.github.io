classDiagram
  class Order {
    +UUID orderId
    +OrderStatus status
    +acceptQuote()
    +confirmPayment()
    +cancel()
  }
  class OrderLine {
    +String skuId
    +int quantity
  }
  class QuoteSnapshot {
    +String quoteId
    +String ruleVersion
  }
  class Money {
    +Decimal amount
    +String currency
  }
  Order "1" *-- "1..*" OrderLine : 聚合内组合
  Order "1" *-- "1" QuoteSnapshot : 成交证据
  OrderLine "1" *-- "1" Money : 分摊金额
